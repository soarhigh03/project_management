{
  "name": "tasktrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "가벼운 버그 추적 + 기능(노드 그래프) 관리 보드",
  "scripts": {
    "dev": "npm run build && node scripts/dev-server.js",
    "build": "esbuild src/note-editor.js --bundle --minify --format=esm --outfile=public/js/note-editor.bundle.js",
    "hash": "node scripts/hash-password.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/y-tiptap": "^3.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
